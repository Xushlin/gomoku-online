<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Occasional developer tool, deliberately NOT part of the API dependency graph
    and NOT registered in Gewu.slnx: it exists to turn the upstream
    chinese-xinhua dump into backend/data/idioms.curated.json, which is what the
    build and CI actually consume. Run it by path when the artefact needs
    regenerating.

    It references Gewu.Domain so tiering comes from the same table-tested
    IdiomTiering.Classify the seeder uses — the importer must never own a second
    copy of that rule.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Gewu.Tools.IdiomImporter</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gewu.Domain\Gewu.Domain.csproj" />
  </ItemGroup>

</Project>
