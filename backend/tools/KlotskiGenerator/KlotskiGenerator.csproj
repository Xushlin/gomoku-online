<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Occasional developer tool, deliberately NOT part of the API dependency graph
    and NOT registered in Gewu.slnx — same posture as CrosswordGenerator and
    IdiomImporter. It emits backend/data/levels/klotski.json, which is what the
    seeder consumes.

    Unlike CrosswordGenerator it does not *generate* layouts: 华容道's classic
    arrangements are cultural objects, not random products. The layouts are
    hand-written in Program.cs; the tool's job is to run the solver over each one
    and record the minimum move count. Layouts are authored, difficulty is measured.

    It references Gewu.Domain so the emitted layout shape comes from the same
    records KlotskiRules deserialises, and so the recorded minMoves comes from the
    same solver the tests re-run — the tool must never own a second copy of either.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Gewu.Tools.KlotskiGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gewu.Domain\Gewu.Domain.csproj" />
  </ItemGroup>

</Project>
