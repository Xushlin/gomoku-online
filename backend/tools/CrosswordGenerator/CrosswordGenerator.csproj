<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Occasional developer tool, deliberately NOT part of the API dependency graph
    and NOT registered in Gewu.slnx — same posture as IdiomImporter. It turns
    backend/data/idioms.curated.json into backend/data/levels/idiom-crossword.json,
    which is what the seeder actually consumes.

    It reads the committed curated artefact rather than the database: 31k idioms
    fit in memory, the artefact is fixed, and a tool that needs no running SQLite
    is a tool that still works a year from now. It references Gewu.Domain so the
    emitted layout/solution shapes come from the same records IdiomCrosswordRules
    deserialises — the generator must never own a second copy of that contract.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Gewu.Tools.CrosswordGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gewu.Domain\Gewu.Domain.csproj" />
  </ItemGroup>

</Project>
