<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      NU1903 was suppressed here for System.Security.Cryptography.Xml 10.0.0
      (GHSA-37gx-xxp4-5rgx, GHSA-w3x6-4m5h-cxqf), with the note "revisit when a
      .NET 10 patch releases a fixed version". 10.0.11 is that version, so the
      suppression is gone rather than merely updated: a NoWarn that outlives the
      advisory it was written for silently swallows the next one.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gewu.Application\Gewu.Application.csproj" />
    <ProjectReference Include="..\Gewu.Domain\Gewu.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The curated idiom artefact travels with the build so a clean checkout plus
      `dotnet run` yields a populated dictionary with no network access. It is
      produced by tools/IdiomImporter and committed; IdiomSeeder reads it from
      `data/idioms.curated.json` relative to AppContext.BaseDirectory.
    -->
    <None Include="..\..\data\idioms.curated.json"
          Link="data\idioms.curated.json"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\data\idioms.curated.json')" />

    <!--
      Same posture for the crossword level set: produced by tools/CrosswordGenerator,
      committed, and read by CrosswordLevelSeeder from `data/levels/idiom-crossword.json`
      relative to AppContext.BaseDirectory.
    -->
    <None Include="..\..\data\levels\idiom-crossword.json"
          Link="data\levels\idiom-crossword.json"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\data\levels\idiom-crossword.json')" />

    <!--
      华容道的关卡产物。布局手写、minMoves 由求解器算出,产物提交进仓库,
      由 PuzzleLevelSeeder 从 `data/levels/klotski.json` 读入。
    -->
    <None Include="..\..\data\levels\klotski.json"
          Link="data\levels\klotski.json"
          CopyToOutputDirectory="PreserveNewest"
          Condition="Exists('..\..\data\levels\klotski.json')" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.11" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.2.1" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.2.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="MediatR" Version="12.4.1" />
    <!-- Override vulnerable transitive pulled in by System.IdentityModel.Tokens.Jwt -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>

</Project>
