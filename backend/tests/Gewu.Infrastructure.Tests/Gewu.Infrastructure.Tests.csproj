<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gewu.Infrastructure\Gewu.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="FluentAssertions" />
    <Using Include="Gewu.Domain.Idioms" />
    <Using Include="Gewu.Infrastructure.Persistence" />
  </ItemGroup>

  <ItemGroup>
    <!--
      真实的《梅花谱》产物跟着测试构建走 —— 因为这个功能的全部依据是「31 条线路、
      1391 个半手全部能过 XiangqiRules」,而那件事只在应用启动时才会被验证一次。
      CI 不启动应用,所以少了这条复制规则,唯一还在守它的就只有一句启动日志。
    -->
    <None Include="..\..\data\manuals\*.json"
          Link="data\manuals\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
