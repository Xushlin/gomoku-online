<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only.

  Android 9+ blocks cleartext HTTP by default, and the local dev API is
  http://10.0.2.2:5145 (the host loopback as seen from an emulator). Without this
  every request fails before it leaves the device, and the screen shows nothing but
  a failed login - indistinguishable from "the backend is not running".

  Scoped to the dev hosts rather than a blanket usesCleartextTraffic="true": a
  release build stays HTTPS-only, and it stays that way without anyone remembering
  to turn a flag back off.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <!-- The host machine's loopback, from inside an Android emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
